{
  "name": "eidolon-hearth",
  "version": "0.1.0",
  "description": "Installs the Eidolon and Setup skills for Claude Code: previews every write, applies only the plan you approved, keeps backups, verifies the bundled files against a lock. Run npx eidolon-hearth for user skills, or npx eidolon-hearth . to wire a project with its hooks.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "eidolon-hearth": "scripts/welcome.mjs"
  },
  "files": [
    "scripts/welcome.mjs",
    "scripts/install.mjs",
    "skills/",
    "vendor-lock.json",
    "README.md",
    "CREDITS.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eidolonofficial/Hearth.git"
  },
  "homepage": "https://eidolonofficial.github.io/",
  "bugs": {
    "url": "https://github.com/eidolonofficial/Hearth/issues"
  },
  "keywords": [
    "claude-code",
    "claude",
    "skills",
    "hooks",
    "installer",
    "eidolon"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}
